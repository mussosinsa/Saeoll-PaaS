[
  {"id": "kr-rrn", "name": "주민등록번호·외국인등록번호", "severity": "high", "validator": "rrn",
   "regex": "(?<![0-9])\\d{2}(?:0[1-9]|1[0-2])(?:0[1-9]|[12]\\d|3[01])-?[1-8]\\d{6}(?![0-9])",
   "description": "생년월일 6자리 + 7자리. 하이픈이 없으면 검증번호가 맞는 경우만 탐지"},
  {"id": "card", "name": "신용카드번호", "severity": "high", "validator": "luhn",
