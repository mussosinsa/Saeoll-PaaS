// {VENDOR}/{APP} pipeline - CI/CD portal (K-PaaS SCM + Jenkins + Argo CD)
//   job {APP}-dev     : develop (Poll SCM, 5 min) -> image dev-<sha>-<build> -> gitops overlays/dev  -> Argo CD auto sync
//   job {APP}-release : RELEASE_TAG=vX.Y.Z        -> image vX.Y.Z           -> gitops overlays/prod -> Argo CD sync by cicd-admins
// Folder credentials (onboard-vendor.sh): {VENDOR}-harbor (Harbor robot), {VENDOR}-scm (SCM account jenkins-{VENDOR})
// Stages: Checkout, Build, Test, Security (source scan), Image, Security Gate (image scan + policy), Deploy
// Language: Node.js / npm
def vendor = '{VENDOR}'
def app = '{APP}'
def harborHost = '{HARBOR_HOST}'
def gitopsRepo = '{GITOPS_REPO_URL}'
def baseRegistry = '{BASE_REGISTRY}'
def kanikoImage = '{KANIKO_IMAGE}'
def buildImage = '{CICD_DOCKERHUB}/node:20-alpine'

def buildScript = '''
if [ -f package-lock.json ]; then npm ci; else npm install; fi
npm run build --if-present
'''
def testScript = '''
npm run lint --if-present
npm test --if-present
'''
def junitReports = ''

// Security scan (./deploy-cicd-portal.sh security-image security): Semgrep, Gitleaks, Trivy, personal information.
// Policy and rules come from ConfigMaps cicd-security-policy / cicd-security-rules (CI/CD console > 품질 관리).
// add-app.sh fills in the scanner image once security is installed; until then the stages are skipped.
def securityImage = '{SECURITY_IMAGE}'
def appType = '{CICD_APP_TYPE}'
def securityEnabled = securityImage && !securityImage.startsWith('{')
def securityContainer = !securityEnabled ? '' : """
    - name: security
      image: ${securityImage}
      command: ["sleep"]
      args: ["infinity"]
      resources:
        requests: {cpu: 250m, memory: 512Mi}
        limits: {memory: 2Gi}
      envFrom:
        - secretRef: {name: cicd-security-defectdojo, optional: true}
      volumeMounts:
        - {name: cicd-ca, mountPath: /etc/cicd-ca, readOnly: true}
        - {name: security-policy, mountPath: /etc/cicd-security/policy, readOnly: true}
        - {name: security-rules, mountPath: /etc/cicd-security/rules, readOnly: true}"""
def securityVolumes = !securityEnabled ? '' : """
    - name: security-policy
      configMap: {name: cicd-security-policy, optional: true}
    - name: security-rules
      configMap: {name: cicd-security-rules, optional: true}
  imagePullSecrets:
    - name: cicd-security-pull"""

// properties() replaces every job property, including the job's triggers: the -dev job keeps its
// Poll SCM trigger here, otherwise its first build removes it and develop pushes are not built.
def jobProperties = [
  disableConcurrentBuilds(),
  buildDiscarder(logRotator(numToKeepStr: '30')),
  parameters([string(name: 'RELEASE_TAG', defaultValue: '', trim: true,
                     description: 'Release job only: tag vX.Y.Z to build and deploy to prod (empty: develop build)')])
]
if (!env.JOB_NAME.endsWith('-release')) {
  jobProperties.add(pipelineTriggers([pollSCM('H/5 * * * *')]))
}
properties(jobProperties)

podTemplate(yaml: """
apiVersion: v1
kind: Pod
spec:
  containers:
    - name: build
      image: ${buildImage}
      command: ["sleep"]
      args: ["infinity"]
      resources:
        requests: {cpu: 250m, memory: 512Mi}
        limits: {memory: 3Gi}
    - name: kaniko
      image: ${kanikoImage}
      command: ["/busybox/cat"]
      tty: true
      resources:
        requests: {cpu: 250m, memory: 512Mi}
        limits: {memory: 3Gi}
      volumeMounts:
        - {name: cicd-ca, mountPath: /etc/cicd-ca, readOnly: true}${securityContainer}
  volumes:
    - name: cicd-ca
      secret: {secretName: cicd-ca}${securityVolumes}
""") {
  node(POD_LABEL) {
    def releaseTag = (params.RELEASE_TAG ?: '').trim()
    def deployEnv = releaseTag ? 'prod' : 'dev'
    def imageTag = ''
    def imageRef = ''
    def scanEnv = []
    // build image runs as root, workspace belongs to the agent user: let git (composer, gradle...) read it
    def gitSafeDir = ['GIT_CONFIG_COUNT=1', 'GIT_CONFIG_KEY_0=safe.directory', 'GIT_CONFIG_VALUE_0=*']

    stage('Checkout') {
      checkout scm
      def commit = sh(script: 'git rev-parse --short=8 HEAD', returnStdout: true).trim()
      if (releaseTag) {
        if (!(releaseTag ==~ /v\d+\.\d+\.\d+/)) {
          error "RELEASE_TAG must look like v1.2.0 (got '${releaseTag}')"
        }
        if (sh(script: "git tag --points-at HEAD | grep -qx '${releaseTag}'", returnStatus: true) != 0) {
          error "Checked-out commit ${commit} is not tag ${releaseTag}. The release job branch must be refs/tags/\${RELEASE_TAG}."
        }
        imageTag = releaseTag
      } else {
        imageTag = "dev-${commit}-${env.BUILD_NUMBER}"
      }
      currentBuild.displayName = "#${env.BUILD_NUMBER} ${deployEnv} ${imageTag}"
      scanEnv = gitSafeDir + ["CICD_APP=${vendor}/${app}", "CICD_ENV=${deployEnv}", "CICD_APP_TYPE=${appType}",
                              "CICD_REF=${releaseTag ?: 'develop'}", "CICD_COMMIT=${commit}",
                              "CICD_BUILD_URL=${env.BUILD_URL}", "CICD_CA_FILE=/etc/cicd-ca/ca.crt"]
    }

    stage('Build') {
      container('build') { withEnv(gitSafeDir) { sh buildScript } }
    }

    stage('Test') {
      try {
        container('build') { withEnv(gitSafeDir) { sh testScript } }
      } finally {
        if (junitReports) {
          try {
            junit allowEmptyResults: true, testResults: junitReports
          } catch (NoSuchMethodError e) {
            echo 'JUnit plugin is not installed - test report skipped (deploy-cicd-portal.sh jenkins installs it)'
          }
        }
      }
    }

    stage('Security') {
      if (!securityEnabled) {
        echo 'Security scan is not set up (./deploy-cicd-portal.sh security-image security, then REPLACE_CI=1 ./add-app.sh)'
        return
      }
      container('security') { withEnv(scanEnv) { sh 'cicd-scan source --dir . --out security' } }
    }

    stage('Image') {
      def image = "${harborHost}/${vendor}/${app}:${imageTag}"
      imageRef = image
      container('kaniko') {
        withCredentials([usernamePassword(credentialsId: "${vendor}-harbor",
                                          usernameVariable: 'HARBOR_USER', passwordVariable: 'HARBOR_PASSWORD')]) {
          withEnv(["IMAGE=${image}", "REGISTRY_HOST=${harborHost}", "BASE_REGISTRY=${baseRegistry}"]) {
            sh '''
              AUTH=$(printf '%s:%s' "$HARBOR_USER" "$HARBOR_PASSWORD" | base64 | tr -d '\\n')
              mkdir -p /kaniko/.docker
              printf '{"auths":{"%s":{"auth":"%s"}}}' "$REGISTRY_HOST" "$AUTH" > /kaniko/.docker/config.json
              /kaniko/executor --context "$WORKSPACE" --dockerfile "$WORKSPACE/Dockerfile" \
                --destination "$IMAGE" --build-arg "BASE_REGISTRY=$BASE_REGISTRY" \
                --registry-certificate "$REGISTRY_HOST=/etc/cicd-ca/ca.crt"
            '''
          }
        }
      }
      echo "Pushed ${image}"
    }

    // Gate: exit 0 pass, 10 limits exceeded in report mode (build UNSTABLE), else fail = no deployment
    stage('Security Gate') {
      if (!securityEnabled) {
        return
      }
      def gate = 0
      try {
        container('security') {
          withCredentials([usernamePassword(credentialsId: "${vendor}-harbor",
                                            usernameVariable: 'TRIVY_USERNAME', passwordVariable: 'TRIVY_PASSWORD')]) {
            withEnv(scanEnv + ["CICD_IMAGE=${imageRef}"]) {
              sh 'cicd-scan image --image "$CICD_IMAGE" --out security'
              gate = sh(script: 'cicd-scan gate --out security', returnStatus: true)
              sh 'cicd-scan upload --out security'
            }
          }
        }
      } finally {
        archiveArtifacts artifacts: 'security/**', allowEmptyArchive: true
      }
      if (gate == 10) {
        unstable('Security limits exceeded (report mode) - CI/CD console > 품질 관리 > 보안 이슈')
      } else if (gate != 0) {
        error('Security gate failed: deployment blocked - CI/CD console > 품질 관리 > 보안 이슈')
      }
    }

    stage('Deploy') {
      container('jnlp') {
        withCredentials([usernamePassword(credentialsId: "${vendor}-scm",
                                          usernameVariable: 'SCM_USER', passwordVariable: 'SCM_PASSWORD')]) {
          withEnv(["GITOPS_REPO=${gitopsRepo}", "OVERLAY=apps/${app}/overlays/${deployEnv}/kustomization.yaml",
                   "IMAGE_TAG=${imageTag}", "COMMIT_MSG=${app} ${deployEnv} -> ${imageTag} (${env.JOB_NAME} #${env.BUILD_NUMBER})"]) {
            sh '''
              set -e
              cred='!f() { echo "username=$SCM_USER"; echo "password=$SCM_PASSWORD"; }; f'
              rm -rf gitops-repo
              git -c credential.helper="$cred" clone -q --depth 1 --branch main "$GITOPS_REPO" gitops-repo
              cd gitops-repo
              git config user.name "Jenkins"
              git config user.email "jenkins@cicd-portal"
              [ -f "$OVERLAY" ] || { echo "$OVERLAY not found - run add-app.sh"; exit 1; }
              for attempt in 1 2 3; do
                sed -i "s|^\\(    newTag:\\).*|\\1 $IMAGE_TAG|" "$OVERLAY"
                git add "$OVERLAY"
                if git diff --cached --quiet; then echo "Already at $IMAGE_TAG"; exit 0; fi
                git commit -q -m "$COMMIT_MSG"
                if git -c credential.helper="$cred" push -q origin HEAD:main; then break; fi
                [ "$attempt" = 3 ] && exit 1
                git -c credential.helper="$cred" fetch -q --depth 1 origin main
                git reset -q --hard origin/main
              done
              echo "gitops $OVERLAY -> $IMAGE_TAG"
            '''
          }
        }
      }
      if (deployEnv == 'prod') {
        echo "Production: ask cicd-admins to sync '${vendor}-${app}-prod' in Argo CD."
      } else {
        echo "Argo CD syncs '${vendor}-${app}-dev' automatically."
      }
    }
  }
}
