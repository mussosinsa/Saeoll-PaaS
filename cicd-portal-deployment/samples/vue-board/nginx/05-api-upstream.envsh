#!/bin/sh
# Sourced by the nginx image entrypoint before the templates are rendered.
# API_UPSTREAM (if not set): http://<API_SERVICE>.<this pod's namespace>.svc.cluster.local
# so the same image works in <vendor>-dev and <vendor>-prod. API_SERVICE default: node-board.
if [ -z "${API_UPSTREAM:-}" ]; then
  ns=$(cat /var/run/secrets/kubernetes.io/serviceaccount/namespace 2>/dev/null || echo default)
  API_UPSTREAM="http://${API_SERVICE:-node-board}.${ns}.svc.cluster.local"
  export API_UPSTREAM
fi
echo "05-api-upstream.envsh: /api/ -> $API_UPSTREAM"
