// Vendor PHP pipeline for the K-PaaS cp-pipeline Jenkins
// (PHP-enabled Jenkins image: php, composer, buildah, kubectl).
//
//   dev  : job <app>-dev,  branch develop, SCM polling -> <vendor>-dev
//   prod : job <app>-prod, branch refs/tags/${RELEASE_TAG}, run by operators,
//          approval required -> <vendor>-prod
//
// Folder-scoped Jenkins credentials (created by script/onboard-php-vendor.sh):
//   <vendor>-harbor-robot      Username/Password (Harbor robot account)
//   <vendor>-kubeconfig-dev    Secret file
//   <vendor>-kubeconfig-prod   Secret file
//
// 품질 관리 (security scan of the CI/CD portal, SECURITY_SCAN=on):
//   Security scan : source code (Semgrep), secrets (Gitleaks), dependencies (Trivy), personal information
//   Security gate : image (Trivy) + the gate of the policy -> pass / UNSTABLE (report mode) / FAILED (no deploy)
//   The scanner image (cicd-portal/security-scanner) runs with buildah; the policy, rules, exceptions and the
//   DefectDojo settings are read at run time from the CI/CD console's ConfigMaps / Secrets in SECURITY_NAMESPACE
//   (cicd-jenkins), so changes made in the console (품질 관리) apply to this pipeline too.
//   One-time setup: cp-pipeline-deployment/script/enable-cicd-security.sh (read access for this Jenkins).
//   Not set up / SECURITY_SCAN=off: the stages are skipped and the build continues.

// Run a cicd-scan command in the scanner container (workspace at /workspace, settings at /cicd-security)
def scanner(String args) {
  return sh(returnStatus: true, script: """
    buildah run --isolation chroot -v "\$WORKSPACE:/workspace" -v "\$SEC_DIR:/cicd-security" \
      "\$(cat "\$SEC_DIR/container")" -- sh /cicd-security/run.sh ${args}
  """)
}

pipeline {
  agent any
  options {
    disableConcurrentBuilds()
    buildDiscarder(logRotator(numToKeepStr: '30'))
  }

  parameters {
    choice(name: 'DEPLOY_ENV', choices: ['dev', 'prod'], description: 'dev: develop branch, prod: release tag')
    string(name: 'VENDOR',      defaultValue: 'vendor-a',              description: 'Vendor id (namespace prefix, Harbor project)')
    string(name: 'APP_NAME',    defaultValue: 'php-sample',            description: 'Application name (lowercase, -)')
    string(name: 'BASE_DOMAIN', defaultValue: 'kpaas.example.co.kr', description: 'Cluster HOST_DOMAIN')
    string(name: 'RELEASE_TAG', defaultValue: '',                      description: 'prod only: release tag, e.g. v1.2.0')
    string(name: 'APPROVERS',   defaultValue: 'admin',                 description: 'prod only: Jenkins users/groups allowed to approve')
    string(name: 'BASE_PROJECT', defaultValue: 'base-images',          description: 'Harbor project with mirrored base images (empty: Docker Hub)')
    choice(name: 'SECURITY_SCAN', choices: ['on', 'off'],              description: '품질 관리 security scan and gate (CI/CD portal)')
    string(name: 'SECURITY_IMAGE', defaultValue: 'auto',               description: "scanner image; auto = harbor.<BASE_DOMAIN>/cicd-portal/security-scanner:1.0.0")
    string(name: 'SECURITY_NAMESPACE', defaultValue: 'cicd-jenkins',   description: 'namespace of the policy ConfigMaps (CI/CD console 품질 관리)')
  }

  environment {
    TARGET_NS    = "${params.VENDOR}-${params.DEPLOY_ENV}"
    HARBOR_HOST  = "harbor.${params.BASE_DOMAIN}"
    APP_HOST     = "${params.DEPLOY_ENV == 'prod' ? "${params.APP_NAME}-${params.VENDOR}" : "${params.APP_NAME}-${params.VENDOR}-dev"}.${params.BASE_DOMAIN}"
    REPLICAS     = "${params.DEPLOY_ENV == 'prod' ? '2' : '1'}"
    TLS_SECRET   = "${params.BASE_DOMAIN}-tls"
    PULL_SECRET  = 'harbor-regcred'
    STORAGE_DRIVER    = 'vfs'
    BUILDAH_ISOLATION = 'chroot'
    SCANNER_IMAGE = "${params.SECURITY_IMAGE == 'auto' ? "harbor.${params.BASE_DOMAIN}/cicd-portal/security-scanner:1.0.0" : params.SECURITY_IMAGE}"
    SEC_DIR       = "${env.WORKSPACE}@cicd-security"   // outside the workspace: never scanned, never archived
  }

  stages {
    stage('Prepare') {
      steps {
        script {
          if (!(params.APP_NAME ==~ /[a-z0-9]([a-z0-9-]*[a-z0-9])?/)) {
            error "APP_NAME must be lowercase letters, digits and '-': ${params.APP_NAME}"
          }
          def commit = sh(script: 'git rev-parse --short=8 HEAD', returnStdout: true).trim()
          if (params.DEPLOY_ENV == 'prod') {
            if (!(params.RELEASE_TAG ==~ /v\d+\.\d+\.\d+/)) {
              error "prod deployment requires RELEASE_TAG like v1.2.0 (got '${params.RELEASE_TAG}')"
            }
            def headTags = sh(script: 'git tag --points-at HEAD', returnStdout: true).trim().split('\n')
            if (!headTags.contains(params.RELEASE_TAG)) {
              error "Checked-out commit ${commit} is not tag ${params.RELEASE_TAG}. Set the job branch to refs/tags/\${RELEASE_TAG}."
            }
            env.IMAGE_TAG = params.RELEASE_TAG
          } else {
            env.IMAGE_TAG = "dev-${commit}-${env.BUILD_NUMBER}"
          }
          env.IMAGE = "${env.HARBOR_HOST}/${params.VENDOR}/${params.APP_NAME}:${env.IMAGE_TAG}"
          currentBuild.displayName = "#${env.BUILD_NUMBER} ${params.DEPLOY_ENV} ${env.IMAGE_TAG}"
          echo "Image: ${env.IMAGE}\nNamespace: ${env.TARGET_NS}\nURL: https://${env.APP_HOST}"
        }
      }
    }

    stage('Composer install') {
      steps {
        sh 'php -v && composer --version'
        sh 'composer validate --no-check-publish'
        sh 'composer install --no-interaction --no-progress --prefer-dist'
      }
    }

    stage('Lint & Test') {
      steps {
        sh '''
          find . -path ./vendor -prune -o -name '*.php' -print0 | xargs -0 -n1 php -l
          if [ -x vendor/bin/phpunit ]; then
            vendor/bin/phpunit --log-junit phpunit-report.xml
          else
            echo "phpunit is not installed (require-dev) - unit tests skipped"
          fi
        '''
      }
      post {
        always {
          script {
            if (fileExists('phpunit-report.xml')) { junit 'phpunit-report.xml' }
          }
        }
      }
    }

    stage('Security scan') {
      when { expression { params.SECURITY_SCAN == 'on' } }
      steps {
        script {
          // settings of the CI/CD console (품질 관리) + the scanner container
          def ready = sh(returnStatus: true, script: '''
            set -e
            rm -rf "$SEC_DIR" security
            mkdir -p "$SEC_DIR/policy" "$SEC_DIR/rules" && chmod 700 "$SEC_DIR"
            if ! kubectl -n "$SECURITY_NAMESPACE" get configmap cicd-security-policy \
                   -o jsonpath='{.data.policy\\.json}' > "$SEC_DIR/policy/policy.json" 2>/dev/null; then
              echo "[security] cannot read $SECURITY_NAMESPACE/cicd-security-policy - not set up"
              echo "           (CI/CD portal: ./deploy-cicd-portal.sh security; then cp-pipeline-deployment/script/enable-cicd-security.sh)"
              exit 3
            fi
            kubectl -n "$SECURITY_NAMESPACE" get configmap cicd-security-rules -o json > "$SEC_DIR/rules.json" 2>/dev/null || echo '{}' > "$SEC_DIR/rules.json"
            kubectl -n "$SECURITY_NAMESPACE" get secret cicd-security-defectdojo -o json > "$SEC_DIR/dojo.json" 2>/dev/null || echo '{}' > "$SEC_DIR/dojo.json"
            kubectl -n "$SECURITY_NAMESPACE" get secret cicd-ca -o jsonpath='{.data.ca\\.crt}' 2>/dev/null | base64 -d > "$SEC_DIR/ca.crt" || true
            kubectl -n "$SECURITY_NAMESPACE" get secret cicd-security-pull -o jsonpath='{.data.\\.dockerconfigjson}' 2>/dev/null | base64 -d > "$SEC_DIR/auth.json" || true
            [ -s "$SEC_DIR/auth.json" ] || echo '{"auths":{}}' > "$SEC_DIR/auth.json"
            cat > "$SEC_DIR/env" <<EOF
CICD_APP=$VENDOR/$APP_NAME
CICD_ENV=$DEPLOY_ENV
CICD_APP_TYPE=php
CICD_REF=$IMAGE_TAG
CICD_COMMIT=$(git rev-parse HEAD)
CICD_BUILD_URL=$BUILD_URL
HOST_UID=$(id -u)
HOST_GID=$(id -g)
EOF
            # entry point in the container: settings from the files above (secrets never on a command line)
            cat > "$SEC_DIR/run.sh" <<'EOF'
set -e
set -a; . /cicd-security/env; set +a
export CICD_SECURITY_POLICY_DIR=/cicd-security/policy CICD_SECURITY_RULES_DIR=/cicd-security/rules
python3 - <<'PY'
import base64, json, os, shlex
rules = json.load(open("/cicd-security/rules.json")).get("data") or {}
for name, text in rules.items():
    if "/" not in name:
        open(os.path.join("/cicd-security/rules", name), "w").write(text)
dojo = json.load(open("/cicd-security/dojo.json")).get("data") or {}
with open("/cicd-security/secrets.sh", "w") as fh:
    for key in ("DEFECTDOJO_URL", "DEFECTDOJO_TOKEN"):
        if dojo.get(key):
            fh.write(f"export {key}={shlex.quote(base64.b64decode(dojo[key]).decode())}\\n")
    for key, path in (("TRIVY_USERNAME", "/cicd-security/trivy-user"), ("TRIVY_PASSWORD", "/cicd-security/trivy-pass")):
        if os.path.exists(path):
            fh.write(f"export {key}={shlex.quote(open(path).read())}\\n")
PY
. /cicd-security/secrets.sh
if [ -s /cicd-security/ca.crt ]; then export CICD_CA_FILE=/cicd-security/ca.crt; else export TRIVY_INSECURE=true; fi
rc=0
"$@" || rc=$?
chown -R "$HOST_UID:$HOST_GID" /workspace/security 2>/dev/null || true
exit $rc
EOF
            buildah from --tls-verify=false --authfile "$SEC_DIR/auth.json" "$SCANNER_IMAGE" > "$SEC_DIR/container"
          ''')
          env.SECURITY_READY = ready == 0 ? '1' : '0'
          if (ready != 0) {
            echo 'Security scan skipped (not set up or scanner image not available - see above)'
            return
          }
          if (scanner('cicd-scan source --dir /workspace --out /workspace/security') != 0) {
            echo 'Security scan could not run completely - see the log'
            currentBuild.result = 'UNSTABLE'
          }
        }
      }
    }

    stage('Build image') {
      steps {
        sh '''
          BUILD_ARGS=""
          if [ -n "$BASE_PROJECT" ]; then
            BUILD_ARGS="--build-arg BASE_REGISTRY=$HARBOR_HOST/$BASE_PROJECT"
          fi
          buildah bud --tls-verify=false --layers --format docker $BUILD_ARGS -t "$IMAGE" .
        '''
      }
    }

    stage('Push to Harbor') {
      steps {
        withCredentials([usernamePassword(credentialsId: "${params.VENDOR}-harbor-robot",
                                          usernameVariable: 'HARBOR_USER', passwordVariable: 'HARBOR_PASS')]) {
          sh '''
            printf '%s' "$HARBOR_PASS" | buildah login --tls-verify=false -u "$HARBOR_USER" --password-stdin "$HARBOR_HOST"
            buildah push --tls-verify=false "$IMAGE" "docker://$IMAGE"
            buildah rmi "$IMAGE" || true
          '''
        }
      }
    }

    // Gate: image scan + policy of the CI/CD console. exit 0 pass, 10 limits exceeded in report mode
    // (UNSTABLE, deployment continues), otherwise FAILED = no deployment.
    stage('Security gate') {
      when { expression { env.SECURITY_READY == '1' } }
      steps {
        withCredentials([usernamePassword(credentialsId: "${params.VENDOR}-harbor-robot",
                                          usernameVariable: 'HARBOR_USER', passwordVariable: 'HARBOR_PASS')]) {
          sh '''
            umask 077
            printf '%s' "$HARBOR_USER" > "$SEC_DIR/trivy-user"
            printf '%s' "$HARBOR_PASS" > "$SEC_DIR/trivy-pass"
          '''
        }
        script {
          scanner("cicd-scan image --image '${env.IMAGE}' --out /workspace/security")
          def gate = scanner('cicd-scan gate --out /workspace/security')
          scanner('cicd-scan upload --out /workspace/security')
          sh 'rm -f "$SEC_DIR/trivy-user" "$SEC_DIR/trivy-pass" "$SEC_DIR/secrets.sh"'
          env.SECURITY_GATE = gate == 0 ? '통과' : gate == 10 ? '경고 (report mode)' : '차단'
          if (gate == 10) {
            // report mode: limits exceeded, the deployment continues (currentBuild.result: old Jenkins has no unstable step)
            echo 'Security limits exceeded (report mode) - security/summary.json, DefectDojo'
            currentBuild.result = 'UNSTABLE'
          } else if (gate != 0) {
            error('Security gate failed: deployment blocked - security/summary.json, DefectDojo')
          }
        }
      }
      post {
        always { archiveArtifacts artifacts: 'security/**', allowEmptyArchive: true }
      }
    }

    stage('Approval') {
      when { expression { params.DEPLOY_ENV == 'prod' } }
      steps {
        timeout(time: 1, unit: 'HOURS') {
          input message: "Deploy ${env.IMAGE} to ${env.TARGET_NS}?" +
                         (env.SECURITY_GATE ? " (보안 게이트: ${env.SECURITY_GATE})" : ' (보안 검사 안 함)'),
                ok: 'Deploy', submitter: params.APPROVERS
        }
      }
    }

    stage('Deploy') {
      steps {
        withCredentials([file(credentialsId: "${params.VENDOR}-kubeconfig-${params.DEPLOY_ENV}", variable: 'KUBECONFIG')]) {
          sh '''
            prev=$(kubectl -n "$TARGET_NS" get deployment "$APP_NAME" \
              -o jsonpath='{.spec.template.spec.containers[0].image}' 2>/dev/null || true)
            echo "Previous image: ${prev:-<none>}"
            sed -e "s|__APP__|$APP_NAME|g" -e "s|__NAMESPACE__|$TARGET_NS|g" \
                -e "s|__IMAGE__|$IMAGE|g" -e "s|__HOST__|$APP_HOST|g" \
                -e "s|__REPLICAS__|$REPLICAS|g" -e "s|__TLS_SECRET__|$TLS_SECRET|g" \
                -e "s|__PULL_SECRET__|$PULL_SECRET|g" k8s/app.yaml > "k8s-rendered.yaml"
            kubectl apply -f k8s-rendered.yaml
            kubectl annotate deployment "$APP_NAME" -n "$TARGET_NS" --overwrite \
              kubernetes.io/change-cause="jenkins #$BUILD_NUMBER $IMAGE_TAG"
            if ! kubectl -n "$TARGET_NS" rollout status deployment/"$APP_NAME" --timeout=300s; then
              echo "Rollout failed - rolling back"
              kubectl -n "$TARGET_NS" rollout undo deployment/"$APP_NAME" || true
              exit 1
            fi
          '''
        }
      }
    }

    stage('Smoke test') {
      steps {
        sh 'curl -fsSk --retry 5 --retry-delay 5 "https://$APP_HOST/healthz.php"'
      }
    }
  }

  post {
    success { echo "Deployed ${env.IMAGE} -> https://${env.APP_HOST}" }
    always  {
      sh '''
        rm -f k8s-rendered.yaml
        if [ -f "$SEC_DIR/container" ]; then buildah rm "$(cat "$SEC_DIR/container")" >/dev/null 2>&1 || true; fi
        rm -rf "$SEC_DIR"
      '''
    }
  }
}
